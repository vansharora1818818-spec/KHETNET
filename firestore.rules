rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@khetnet.com'
      ); 
    }

    function isHost() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'host'
      );
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- USERS ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               (data.age == null || (data.age is number && data.age >= 18)) &&
               (data.mobile == null || (data.mobile is string && data.mobile.size() <= 20));
      }

      allow get: if isSignedIn(); // allow profile viewing for and by other users for trading/matching transparency
      allow list: if isSignedIn(); // needed for matching algorithms and dashboards
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isHost()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'age', 'mobile', 'email', 'language', 'role', 'state', 'region', 
          'isSubscribed', 'subscriptionTier', 'viewsRemaining', 'isVerified', 
          'aadhaarDigits', 'otpVerified', 'trustScore', 'tradeHistoryCount', 'buyerRating'
        ]) && isValidUser(incoming())) ||
        isHost()
      );
      allow delete: if isHost();
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.costPerKg is number && data.costPerKg > 0 &&
               data.maxQuantity is number && data.maxQuantity >= 0 &&
               isValidId(data.farmerId);
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidProduct(incoming()) && isOwner(incoming().farmerId);
      allow update: if isSignedIn() && (
        // Farmer Update
        (isOwner(existing().farmerId) && isValidProduct(incoming())) ||
        // Wholesaler Purchase
        (incoming().diff(existing()).affectedKeys().hasOnly(['maxQuantity']) && incoming().maxQuantity >= 0) ||
        // Escrow/Status
        (incoming().diff(existing()).affectedKeys().hasAll(['maxQuantity']) || isHost())
      );
      allow delete: if isHost() || isOwner(existing().farmerId);
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.productName is string &&
               data.totalCost is number &&
               data.quantity is number && data.quantity > 0 &&
               isValidId(data.productId) &&
               isValidId(data.farmerId) &&
               isValidId(data.wholesalerId);
      }

      allow get: if isSignedIn() && (isOwner(existing().farmerId) || isOwner(existing().wholesalerId) || isHost());
      allow list: if isSignedIn() && (
        (resource.data.farmerId == request.auth.uid) || 
        (resource.data.wholesalerId == request.auth.uid) || 
        isHost()
      );
      
      allow create: if isSignedIn() && isValidOrder(incoming()) && isOwner(incoming().wholesalerId);
      allow update: if isSignedIn() && (
        // Status Transition Engine for Escrow (supports pending, approved, declined, escrow_deposited, delivered, escrow_released)
        (isOwner(existing().farmerId) || isOwner(existing().wholesalerId)) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'escrowHeldAt', 'escrowReleasedAt'])
      ) || isHost();
      allow delete: if isHost();
    }

    // --- LOGIN SESSIONS ---
    match /login_sessions/{sessionId} {
      allow read: if isHost();
      allow create: if isSignedIn() && isOwner(incoming().userId);
    }

    // --- LOGISTICS BOOKINGS ---
    match /logistics_bookings/{bookingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isHost();
    }

    // --- CROP INSURANCES ---
    match /crop_insurances/{insuranceId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isHost();
    }

    // --- COMMUNITY POSTS ---
    match /community_posts/{postId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid == existing().userId || isHost());
    }

    // --- KHATA ENTRIES ---
    match /khata_entries/{entryId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == existing().userId);
    }

    // --- CHATS ---
    match /chats/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().participants || isHost());
      allow create: if isSignedIn() && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (request.auth.uid in existing().participants) && (incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastUpdate']));
      
      match /messages/{msgId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(orderId)).data.participants.hasAny([request.auth.uid]) || isHost());
        allow create: if isSignedIn() && isOwner(incoming().senderId) && (get(/databases/$(database)/documents/chats/$(orderId)).data.participants.hasAny([request.auth.uid]));
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
    
    match /test/connection {
      allow read: if true;
    }

    // --- SYSTEM ALERTS ---
    match /system_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if isHost();
    }

    // --- LEADS ---
    match /leads/{leadId} {
      allow read: if isHost();
      allow create: if true;
    }

    // --- STOCKS ---
    match /stocks/{stockId} {
      function isValidStock(data) {
        return data.cropName is string && data.cropName.size() <= 100 &&
               data.quantity is number && data.quantity >= 0 &&
               data.grade is string && data.grade.size() <= 50 &&
               data.location is string && data.location.size() <= 200 &&
               isValidId(data.userId);
      }

      allow get: if isSignedIn() && isValidId(stockId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isHost());
      allow create: if isSignedIn() && isValidId(stockId) && isValidStock(incoming()) && isOwner(incoming().userId);
      allow update: if isSignedIn() && isValidId(stockId) && isOwner(existing().userId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['quantity']) && incoming().quantity >= 0) ||
        (isValidStock(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt)
      );
      allow delete: if isSignedIn() && isValidId(stockId) && isOwner(existing().userId);
    }

    // --- USERNAME LOCKS ---
    match /username_locks/{username} {
      allow get, create: if true;
      allow update, delete: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
